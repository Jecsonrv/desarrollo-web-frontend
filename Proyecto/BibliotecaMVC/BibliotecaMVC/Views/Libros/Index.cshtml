@model IEnumerable<BibliotecaMVC.Models.Libro>
@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-dark">Nuevo libro</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titulo</th>
            <th>Autor</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Estado</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @if (!Model.Any())
    {
        <tr>
            <td colspan="7" class="text-center text-muted">No hay libros registrados.</td>
        </tr>
    }
    else
    {
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.ID</td>
                <td>@libro.Titulo</td>
                <td>@libro.Autor</td>
                <td>@libro.Categoria</td>
                <td>@libro.Precio.ToString("C")</td>

                <td>
                    @if (libro.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Prestado</span>
                    }
                </td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@libro.ID" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
