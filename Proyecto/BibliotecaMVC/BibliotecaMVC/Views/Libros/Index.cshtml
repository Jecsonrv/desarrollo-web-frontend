@model List<BibliotecaMVC.Models.Libro>
@{
    ViewData["Title"] = "Catálogo de Libros";
}

<h2>@ViewData["Title"]</h2>

<a asp-action="Create" class="btn btn-dark mb-3">Nuevo Libro +</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titulo</th>
            <th>Autor</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var libro in Model)
    {
        <tr>
            <td>@libro.ID</td>
            <td>@libro.Titulo</td>
            <td>@libro.Autor</td>
            <td>@libro.Categoria</td>
            <td>$@libro.Precio</td>

            <td>
                @if (libro.Disponible)
                {
                    <span class="badge bg-success">Disponible</span>
                }
                else
                {
                    <span class="badge bg-danger">Prestado</span>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@libro.ID" class="btn btn-sm btn-outline-secondary">Ver detalles</a>
                <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-sm btn-outline-dark">Editar</a>
                <a asp-action="Delete" asp-route-id="@libro.ID" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
