@* @using BibliotecaMVC.Models
@{
    List<Libro> libros = ViewBag.Libros;
    };
 *@
@model List<BibliotecaMVC.Models.Libro>
<h2>Catalogo de Libros</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titulo</th>
            <th>Autor</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var libro in Model)
    {
        <tr>
            <td>@libro.ID</td>
            <td>@libro.Titulo</td>
            <td>@libro.Autor</td>
            <td>@libro.Categoria</td>
            <td>$@libro.Precio</td>

            <td>
                @if (@libro.Disponible)
                {
                    <spam class="badge bg-success">Disponible</spam>
                }
                else
                {
                    <spam class="badge bg-danger">Prestado</spam>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
