@model BibliotecaMVC.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<h1 class="text-danger">@ViewData["Title"]</h1>

<div class="alert alert-danger" role="alert">
    <strong>¿Estás seguro que deseas eliminar esta categoría?</strong> Esta acción no se puede deshacer.
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">@Model.Nombre</h5>
        <p class="card-text">@Model.Descripcion</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-outline-danger">Confirmar Eliminación</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
