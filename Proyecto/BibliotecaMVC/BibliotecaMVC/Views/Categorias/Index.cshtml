@model IEnumerable<BibliotecaMVC.Models.Categoria>

@{
    ViewData["Title"] = "Listado de Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="mb-0">Hay @Model.Count() categorías registradas</p>
    </div>
    <a asp-action="Create" class="btn btn-dark">Nueva Categoría +</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Nombre</td>
                    <td>@categoria.Descripcion</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@categoria.ID" class="btn btn-sm btn-outline-dark">Editar</a>
                        <a asp-action="Delete" asp-route-id="@categoria.ID" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
