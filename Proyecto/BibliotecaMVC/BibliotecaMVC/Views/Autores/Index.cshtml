@model List<BibliotecaMVC.Models.Autor>

<h2>Autores</h2>


<table class="table table-striped">
   <thead>
       <tr>
           <th>ID</th>
           <th>Nombre</th>
           <th>Apellido</th>
           <th>Nacionalidad</th>
           <th>Fecha de Nacimiento</th>
           <th>Activo</th>
       </tr>
   </thead>
   <tbody>
        @foreach(var autor in Model)
        {
            <tr>
                <td>@autor.ID</td>
                <td>@autor.Nombre</td>
                <td>@autor.Apellido</td>
                <td>@autor.Nacionalidad</td>
                <td>@autor.FechaNacimiento</td>
                <td>
                @if (@autor.Activo)
                {
                    <span class="badge bg-success">Sí</span>
                }
                else
                {
                    <span class="badge bg-danger">No</span>
                }
                </td>
            </tr>
        }
    </tbody>
</table>