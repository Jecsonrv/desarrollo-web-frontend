
@model IEnumerable<BibliotecaMVC.Models.Autor>
@{
    ViewData["Title"] = "Autores";
}

<h1>@ViewData["Title"]</h1>

<p>Hay @Model.Count() autores registrados</p>

<a asp-action="Create" class="btn btn-dark mb-3">Nuevo Autor +</a>

<div class="row">
    @foreach(var autor in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card mb-4 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@autor.Nombre @autor.Apellido</h5>


                    <h6 class="card-subtitle mb-2 text-muted">@autor.Nacionalidad</h6>

                    <p class="card-text mb-3">Edad: <strong>@(DateTime.Now.Year - autor.FechaNacimiento.Year)</strong></p>

                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-action="Details" asp-route-id="@autor.ID" class="btn btn-outline-primary">Ver detalles</a>
                        </div>
                        <div>
                            <a asp-action="Edit" asp-route-id="@autor.ID" class="btn btn-outline-secondary swal-eit-link">Editar</a>
                        </div>
                        <div>
                            <a asp-action="Delete" asp-route-id="@autor.ID" class="btn btn-sm btn-outline-danger mb-1">Eliminar</a>
                        </div>
                        
                    </div>
                </div>

            </div>
        </div>
    }
</div>