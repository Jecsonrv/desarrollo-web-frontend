
@model IEnumerable<BibliotecaMVC.Models.Autor>
@{
    ViewData["Title"] = "Listado de Autores";
}

<h1>@ViewData["Title"]</h1>

<p>Hay @Model.Count() autores registrados</p>

<a asp-action="Create" class="btn btn-dark mb-3">Nuevo Autor +</a>

<div class="row">
    @foreach(var autor in Model)
    {
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@autor.Nombre</h5>

                    <h6>@autor.Nacionalidad</h6>

                    <p>Edad: @(DateTime.Now.Year - autor.FechaNacimiento.Year)</p>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Details" asp-route-id="@autor.ID" class="btn btn-sm btn-outline-secondary">Ver detalles</a>
                        <a asp-action="Edit" asp-route-id="@autor.ID" class="btn btn-sm btn-outline-dark mb-1">Editar</a>
                        <a asp-action="Delete" asp-route-id="@autor.ID" class="btn btn-sm btn-outline-danger mb-1">Eliminar</a>
                    </div>
                </div>

            </div>
        </div>
    }
</div>